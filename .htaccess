# 蕃汉 TANGUT Lab · Apache 伪静态 + 缓存 + MIME
# 上传到站点根目录（与 index.php 同级）

DirectoryIndex index.php
Options -Indexes

# 字体/图片 MIME（部分服务器默认缺失，会导致字形不显示）
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/json .json

<IfModule mod_rewrite.c>
  RewriteEngine On

  # REST API 只读 JSON（/api/v1/* → api.php?path=*）
  RewriteRule ^api/v1/?(.*)$ api.php?path=$1 [L,QSA,B]

  # 汉字详情页 /x-青/ 或 /x-青 → x.php?h=青
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^x-([^/]+)/?$ x.php?h=$1 [L,QSA,B]

  # 字头详情页 /c-0257/ 或 /c-0257 → c.php?c=0257
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^c-([^/]+)/?$ c.php?c=$1 [L,QSA,B]

  # /about → about.php
  RewriteRule ^about/?$ about.php [L]

  # 部首检字 /radical/ /radical/{system}/ /radical/{system}/{cp}/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^radical/([^/]+)/([^/]+)/?$ radical.php?system=$1&r=$2 [L,QSA,B]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^radical/([^/]+)/?$ radical.php?system=$1 [L,QSA,B]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^radical/?$ radical.php [L]

  # 笔画检字 /stroke/ /stroke/{n}/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^stroke/([^/]+)/?$ stroke.php?n=$1 [L,QSA,B]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^stroke/?$ stroke.php [L]

  # /sitemap.xml → sitemap.php（动态生成）
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# 不缓存 .env（敏感配置）
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
