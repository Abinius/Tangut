# Tangut Dictionary 配置模板（提交，不含敏感值）。复制为 .env 后使用。
DATA_VERSION=2026.11.0
SITE_URL=https://voue.cn
RATE_LIMIT_PER_MIN=60

# 品牌（视觉 LOGO，独立于站点标题；header/hero 用此项）
BRAND=TANGUT
BRAND_TAGLINE=蕃汉合时掌中珠

# SEO / 分享（站点标题独立于品牌名；<title>/og:title 用 SITE_TITLE）
SITE_NAME=Tangut Dictionary
SITE_TITLE=Tangut Dictionary — 汉字·西夏文查询
SITE_DESCRIPTION=免费公益工具：输入姓名、姓氏或任意汉字，查看西夏文候选、拟音与义项依据（多候选为常态，tier 为自动分层近似）。
OG_TITLE=TANGUT — 汉字→西夏文查询
OG_DESCRIPTION=输入任意汉字，查看西夏文候选及义项依据（免费公益工具）。
OG_IMAGE=/og-image.png
OG_TYPE=website
TWITTER_CARD=summary_large_image

# 备案（工信部 ICP 备案 → 链接工信部官网；公安备案）
ICP_BEIAN=陕ICP备20002322号-1
ICP_URL=https://beian.miit.gov.cn/
GONGAN_BEIAN=
GONGAN_URL=https://beian.mps.gov.cn/

# 展示文案（API 自描述 / 免责声明 / 许可）
DISCLAIMER_ZH=西夏文与汉字非一一对应，多候选为常态；候选项据 tangutdata 中文释义反查 + 同音替代生成，tier 为自动分层近似。
DISCLAIMER_EN=Tangut-Chinese correspondence is many-to-many; candidates by tangutdata gloss reverse-lookup + homophone substitution; tier auto-layered (approximate).
LICENSE_TEXT=映射数据 tangutdata (MIT) 开放；释义版权归原出版社，引用须注明出处。

# 页脚 colophon（印刷品式署名行；PRESS/EDITION 自动取域名/版本，此处配 PAPER 与 TYPE 两段）
COLOPHON_PAPER=WARM WHITE #FAFAF8
COLOPHON_TYPE=LIGHT GROTESK + NOTO SERIF TANGUT

# 友链（页脚「友链：」行；站名|URL，逗号分隔多组；留空则隐藏该行）
FRIEND_LINKS=Tangut Data|https://github.com/tangutdata, Noto Serif Tangut|https://github.com/notofonts/tangut
